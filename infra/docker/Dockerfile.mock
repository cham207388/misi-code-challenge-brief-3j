# syntax=docker/dockerfile:1.7
ARG MODULE=applicant-registry
FROM eclipse-temurin:25-jdk AS build
WORKDIR /src
ARG MODULE
COPY gradle gradle
COPY gradlew gradlew
COPY gradle.properties settings.gradle.kts build.gradle.kts ./
COPY gradle/libs.versions.toml gradle/libs.versions.toml
COPY build-logic build-logic
COPY mocks mocks
RUN chmod +x gradlew && ./gradlew --no-daemon :mocks:${MODULE}:bootJar

FROM eclipse-temurin:25-jre
ARG MODULE
RUN useradd --system --uid 10001 --create-home memorial \
    && apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /src/mocks/${MODULE}/build/libs/*.jar /app/app.jar
USER memorial
EXPOSE 8080
HEALTHCHECK --interval=20s --timeout=5s --start-period=30s --retries=8 \
  CMD curl -fsS http://127.0.0.1:8080/actuator/health/liveness || exit 1
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "/app/app.jar"]
